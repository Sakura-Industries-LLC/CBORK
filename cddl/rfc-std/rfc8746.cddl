;! # Concise Binary Object Representation (CBOR) Tags for Typed Arrays
;!
;! ## Types from Table 6

rfc8746 = ta-uint8 /
          ta-uint16be /
          ta-uint32be /
          ta-uint64be /
          ta-uint8-clamped /
          ta-uint16le /
          ta-uint32le /
          ta-uint64le /
          ta-sint8 /
          ta-sint16be /
          ta-sint32be /
          ta-sint64be /
          ta-sint16le /
          ta-sint32le /
          ta-sint64le /
          ta-float16be /
          ta-float32be /
          ta-float64be /
          ta-float128be /
          ta-float16le /
          ta-float32le /
          ta-float64le /
          ta-float128le /
          homogeneous<[uint, uint]> /
          multi-dim<[uint, uint], [* bstr]> /
          multi-dim-column-major<[uint, uint], [* bstr]>


ta-uint8 = #6.64(bstr)
ta-uint16be = #6.65(bstr)
ta-uint32be = #6.66(bstr)
ta-uint64be = #6.67(bstr)
ta-uint8-clamped = #6.68(bstr)
